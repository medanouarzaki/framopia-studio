# Framopia Studio — required environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Required: Gemini API key for ASR, understanding, and image generation.
GEMINI_API_KEY=

# Optional (future hook): ElevenLabs fallback ASR.
# ELEVENLABS_API_KEY=

# Backend server port (default: 8000).
# BACKEND_PORT=8000

# Cost controls
# MAX_IMAGES_PER_JOB=8
# CHEAP_MODE=false
# COST_CEILING_USD=2.00
