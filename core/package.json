      "types": "./dist/build-stamp.d.ts",
      "default": "./dist/build-stamp.js"
    },
    "./entry-resolve": {
      "types": "./dist/entry-resolve.d.ts",
      "default": "./dist/entry-resolve.js"
    },
    "./cache-select": {
      "types": "./dist/cache-select.d.ts",
      "default": "./dist/cache-select.js"
    },
    "./align-score": {
      "types": "./dist/align-score.d.ts",
      "default": "./dist/align-score.js"
    },
    "./aligner-hash": {
      "types": "./dist/aligner-hash.d.ts",
      "default": "./dist/aligner-hash.js"
    },
    "./process-alive": {
      "types": "./dist/process-alive.d.ts",
      "default": "./dist/process-alive.js"
    },
