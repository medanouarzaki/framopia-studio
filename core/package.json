    "build": "tsc",
    "validate:modes": "tsx src/validate-modes-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.13.0",
    "happy-dom": "^20.11.12",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
