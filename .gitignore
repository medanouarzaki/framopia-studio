.local/
node_modules/
dist/
*.log
.DS_Store
.env
tools/cv/.venv/
# Downloaded model weights, pinned by sha256 in tools/cv/models.json.
tools/cv/models/
benchmarks/results/
benchmarks/whisper/.venv/
benchmarks/whisper/models/

# generated edit plans: derived from footage that is itself gitignored, and
# rewritten on every run
*.editplan.json
# and the backups a migration takes beside them; *.editplan.json does not
# match a suffixed name, so these were committable until Block 6 session 5
*.editplan.json.*

# video files (watermark master is committed explicitly)
*.mp4
*.mov
!assets/watermark/*.mov

# After Effects
Adobe After Effects Auto-Save/
*.aep~

# Generated images and cutouts live in the cache under .local/, which is
# already ignored; these cover a candidate written anywhere else.
*.generated.png
*.generated.jpg
*.cutout.png

# Sidecar cutouts and their review page (regenerated by tools/cv)
benchmarks/results/latest-cutouts/
*.cutout.png

# Compiled python bytecode from the cv sidecar.
__pycache__/
.pytest_cache/

# The panel bundle is built from panel/src; CEP loads it from here.
panel/dist/

# session 35 flattens a cutout beside it at build time
*.on-fill.png

# A client's own photographs.
#
# Mohamed ruled on 2026-09-05 that attaching a photograph copies it into the
# project, so the path on a client survives the drive it came from. That put a
# real person's face inside the working copy of a repository with a remote, and
# nothing kept it out of a commit: session 81 found fourteen of Dr Loubna
# Kfafi's here, 25.5 MB, untracked in a directory nobody had ignored, where
# `git add -A` would have staged every one.
#
# Ignored so no ordinary command sweeps them up. The ignore is not the whole
# guard — a `-f` overrides it and this file can be edited — so
# `scripts/check-no-photographs-staged.mjs` fails the gate if one is ever
# staged. Nothing here deletes or moves them; they stay exactly where the panel
# put them.
assets/client-pictures/
