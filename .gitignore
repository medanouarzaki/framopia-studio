.local/
node_modules/
dist/
*.log
.DS_Store
.env
tools/cv/.venv/
# Downloaded model weights, pinned by sha256 in tools/cv/models.json.
tools/cv/models/
benchmarks/results/
benchmarks/whisper/.venv/
benchmarks/whisper/models/

# generated edit plans: derived from footage that is itself gitignored, and
# rewritten on every run
*.editplan.json
# and the backups a migration takes beside them; *.editplan.json does not
# match a suffixed name, so these were committable until Block 6 session 5
*.editplan.json.*

# video files (watermark master is committed explicitly)
*.mp4
*.mov
!assets/watermark/*.mov

# After Effects
Adobe After Effects Auto-Save/
*.aep~

# Generated images and cutouts live in the cache under .local/, which is
# already ignored; these cover a candidate written anywhere else.
*.generated.png
*.generated.jpg
*.cutout.png

# Sidecar cutouts and their review page (regenerated by tools/cv)
benchmarks/results/latest-cutouts/
*.cutout.png

# Compiled python bytecode from the cv sidecar.
__pycache__/
.pytest_cache/

# The panel bundle is built from panel/src; CEP loads it from here.
panel/dist/

# session 35 flattens a cutout beside it at build time
*.on-fill.png

# A client's own photographs are NOT ignored.
#
# Session 82 ignored them, on the position that a client's photograph never
# leaves the machine. **Mohamed reversed that on 2026-09-10**: they go to
# GitHub, all of them, with no exception and no prompt. His grounds, recorded
# because they are what the ruling rests on: the repository is public and
# deliberately so; the fourteen files are AI-generated product mockups he made
# himself, not photographs of any person; and he accepts that a public push is
# permanent and that deleting a file later does not remove it from the history.
#
# So there is no rule here. The line that was here is gone, and this note is
# what a future session finds in its place.
