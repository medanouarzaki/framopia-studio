{
  "name": "framopia-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest --run",
    "test:watch": "vitest",
    "build": "tsc && node ../scripts/write-build-stamp.mjs",
    "start": "node dist/server.js",
    "service": "node dist/service.js",
    "transcribe": "tsx src/transcribe-cli.ts",
    "analyse": "tsx src/analyse-cli.ts",
    "validate-plan": "tsx src/validate-plan-cli.ts",
    "bakeoff": "tsx src/images/bakeoff-cli.ts",
    "recompose": "tsx src/analysis/recompose-cli.ts",
    "cutouts": "tsx src/images/cutouts-cli.ts",
    "images": "tsx src/images/images-cli.ts",
    "plan-page": "tsx src/images/plan-page-cli.ts",
    "frames": "tsx src/frames/frames-cli.ts",
    "face-sheets": "tsx src/frames/face-sheets-cli.ts",
    "segment": "tsx src/frames/segment-cli.ts",
    "zones": "tsx src/frames/zones-cli.ts",
    "components": "tsx src/frames/components-cli.ts",
    "image-ceiling": "tsx src/placement/image-ceiling-cli.ts",
    "image-fill": "tsx src/placement/image-fill-cli.ts",
    "image-size": "tsx src/placement/image-size-cli.ts",
    "place": "tsx src/placement/place-cli.ts",
    "probe:image": "tsx src/build/image-probe-cli.ts",
    "wrap:survey": "tsx src/build/wrap-survey-cli.ts",
    "build:reel": "tsx src/build/build-reel-cli.ts",
    "backup": "tsx src/backup/backup-cli.ts",
    "build:comp": "tsx src/build/build-comp-cli.ts",
    "migrate:sfx-placement": "tsx src/analysis/migrate-sfx-placement-cli.ts",
    "migrate:templates-sfx": "tsx src/analysis/migrate-templates-sfx-cli.ts",
    "repair:source-text": "tsx src/transcription/repair-source-text-cli.ts",
    "repair:candidate-paths": "tsx src/images/repair-candidate-paths-cli.ts",
    "migrate:regroup": "tsx src/analysis/migrate-regroup-cli.ts",
    "migrate:alignment": "tsx src/transcription/migrate-alignment-cli.ts",
    "migrate:display-timing": "tsx src/analysis/migrate-display-timing-cli.ts",
    "diagnose:missing": "tsx src/analysis/missing-cards-cli.ts",
